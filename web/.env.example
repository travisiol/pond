# Copy to .env.local. These are inlined into the page at build time.

# Where the game server is. Leave empty when the server serves the page itself.
NEXT_PUBLIC_GAME_SERVER=
# The deployed Arena contract.
NEXT_PUBLIC_GAME_ARENA=
# The token tied to the game, shown on the rules tab once set.
NEXT_PUBLIC_GAME_TOKEN=
NEXT_PUBLIC_GAME_TOKEN_SYMBOL=
NEXT_PUBLIC_GAME_TOKEN_BUY_URL=
NEXT_PUBLIC_GAME_URL=
NEXT_PUBLIC_GAME_X=
