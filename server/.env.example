# Copy to .env and fill in. Never commit the real file.

PORT=8962
DB_PATH=./data/frenzy.sqlite
APP_NAME=FRENZY
# The page's origin once it is public, e.g. https://frenzy.example. "*" in development.
ORIGIN=*

# "off": play money, no deposits, no withdrawals. "on": real ETH.
CHAIN=off
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
# The deployed Arena contract and the block it was deployed at.
ARENA_ADDRESS=
START_BLOCK=0
# The key that signs withdrawal vouchers. Its address must be the contract's signer.
# Anyone holding it can authorise any payout: keep it out of the repo.
PAYOUT_SIGNER_KEY=

# The economy.
# One life, in coins of 0.000001 ETH (2000 = 0.002 ETH).
ENTRY_COINS=2000
# Fee on each entry, in basis points (1000 = 10%).
FEE_BPS=1000
# Share of that fee that goes to the pot; the rest goes to the treasury.
FEE_POT_SHARE_BPS=5000
# The wallet that withdraws the treasury's share.
TREASURY_ADDRESS=
BOT_COUNT=14
RAIN_PER_MINUTE=2400

# Development doors. The server refuses to start with these and CHAIN=on.
DEV_FAUCET=false
DEV_AUTH=false
TIME_SCALE=1
